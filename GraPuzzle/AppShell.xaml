<?xml version="1.0" encoding="UTF-8" ?>

<!-- Główna konfiguracja nawigacji aplikacji -->
<Shell
    x:Class="GraPuzzle.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GraPuzzle"
    Title="GraPuzzle">

    <!-- Definicja głównej strony aplikacji -->
    <ShellContent

        <!-- Tytuł zakładki/strony -->
        Title="Home"

        <!-- Ustawienie strony MainPage jako zawartości -->
        ContentTemplate="{DataTemplate local:MainPage}"

        <!-- Trasa nawigacyjna strony -->
        Route="MainPage" />

</Shell>
