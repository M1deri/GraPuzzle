<!-- Strona puzzla 1 w grze -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GraPuzzle.Puzzle1"
             Title="Puzzle1">

    <!-- Główny kontener absolutny (pozycjonowanie elementów na ekranie) -->
    <AbsoluteLayout x:Name="MainLayout">

        <!-- Tło pokoju / drzwi -->
        <Image Source="drzwi1.png"
               AbsoluteLayout.LayoutBounds="0,0,1,1"
               AbsoluteLayout.LayoutFlags="All"/>

        <!-- Wyświetlanie kodu do odgadnięcia -->
        <Label x:Name="CodeDisplay"
               Text="____"
               FontSize="30"
               TextColor="White"
               HorizontalTextAlignment="Center"
               AbsoluteLayout.LayoutBounds="0.5,0.75,0.4,0.1"
               AbsoluteLayout.LayoutFlags="All"/>

        <!-- Strzałka lewa (zmiana wartości w lewo) -->
        <Button ImageSource="strzalka.png"
                BackgroundColor="Transparent"
                BorderWidth="0"
                AbsoluteLayout.LayoutBounds="0.05,0.5,60,60"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Rotation="180"
                Clicked="OnLeftArrowClicked1"/>

        <!-- Strzałka prawa (zmiana wartości w prawo) -->
        <Button ImageSource="strzalka.png"
                BackgroundColor="Transparent"
                BorderWidth="0"
                AbsoluteLayout.LayoutBounds="0.95,0.5,60,60"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OnRightArrowClicked1"/>

        <!-- Przycisk powrotu -->
        <Button ImageSource="back_button.png"
                BackgroundColor="Transparent"
                AbsoluteLayout.LayoutBounds="0.0,0.0,80,80"
                AbsoluteLayout.LayoutFlags="PositionProportional"/>

        <!-- Przycisk ekwipunku -->
        <Button ImageSource="inventory_button.png"
                BackgroundColor="Transparent"
                AbsoluteLayout.LayoutBounds="1,0,80,80"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OnInventoryClicked"/>

    </AbsoluteLayout>

</ContentPage>
